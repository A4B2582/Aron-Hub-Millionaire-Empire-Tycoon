local MainSection = Tabs.Main:Section({ Title = "Millionaire Empire Kontrolleri" })

MainSection:Paragraph({
    Title = "Aron Hub Aktif!",
    Content = "Yapımcı: qmiracxws\nDurum: Kaydırma ve Kontrollü Fly aktif.",
