local VisualsSection = Tabs.Visuals:Section({ Title = "Görsel ve Hareket Araçları" })

-- 1. Kontrollü Uçuş (Fly) Modülü
local FlyConnection = nil
local FlyActive = false
local KeysPressed = {W = false, S = false, A = false, D = false, Space = false, Shift = false}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.W then KeysPressed.W = true end
    if input.KeyCode == Enum.KeyCode.S then KeysPressed.S = true end
    if input.KeyCode == Enum.KeyCode.A then KeysPressed.A = true end
    if input.KeyCode == Enum.KeyCode.D then KeysPressed.D = true end
    if input.KeyCode == Enum.KeyCode.Space then KeysPressed.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftShift then KeysPressed.Shift = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then KeysPressed.W = false end
    if input.KeyCode == Enum.KeyCode.S then KeysPressed.S = false end
    if input.KeyCode == Enum.KeyCode.A then KeysPressed.A = false end
    if input.KeyCode == Enum.KeyCode.D then KeysPressed.D = false end
    if input.KeyCode == Enum.KeyCode.Space then KeysPressed.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftShift then KeysPressed.Shift = false end
end)

VisualsSection:Slider({
    Title = "Uçuş Hızı (Fly Speed)",
    Desc = "Uçarken hareket etme hızını ayarlar.",
    Min = 10,
    Max = 200,
    Default = 50,
    Step = 5,
    Callback = function(Value)
        Config.FlySpeed = Value
    end,
})

VisualsSection:Toggle({
    Title = "Uçuş Modu (Fly)",
    Desc = "Karakteri tamamen senin kontrolünde tutarak uçurur.",
    Default = false,
    Callback = function(State)
        FlyActive = State
        
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        
        if FlyActive then
            if humanoid then humanoid.PlatformStand = true end
            
            -- Otomatik fırlama yok: Sadece tuşlara bastıkça veya yön verdiğinde hareket eder
            FlyConnection = RunService.RenderStepped:Connect(function()
                pcall(function()
                    if not FlyActive or not char or not hrp.Parent then return end
                    
                    local camera = workspace.CurrentCamera
                    local moveDir = Vector3.new(0, 0, 0)
                    local camCFrame = camera.CFrame
                    
                    if KeysPressed.W then moveDir = moveDir + camCFrame.LookVector end
                    if KeysPressed.S then moveDir = moveDir - camCFrame.LookVector end
                    if KeysPressed.A then moveDir = moveDir - camCFrame.RightVector end
                    if KeysPressed.D then moveDir = moveDir + camCFrame.RightVector end
                    if KeysPressed.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
                    if KeysPressed.Shift then moveDir = moveDir - Vector3.new(0, 1, 0) end
                    
                    if moveDir.Magnitude > 0 then
                        hrp.Velocity = moveDir.Unit * Config.FlySpeed
                    else
                        hrp.Velocity = Vector3.new(0, 0.1, 0) -- Havada asılı kalma (düşmeme)
                    end
                end)
            end)
            
            WindUI:Notify({
                Title = "Uçuş Modülü",
                Content = "Kontrollü uçuş etkinleştirildi.",
                Duration = 3,
            })
        else
            if FlyConnection then
                FlyConnection:Disconnect()
                FlyConnection = nil
            end
            
            if humanoid then humanoid.PlatformStand = false end
            if hrp then hrp.Velocity = Vector3.new(0, 0, 0) end
            
            WindUI:Notify({
                Title = "Uçuş Modülü",
                Content = "Uçuş modu kapatıldı.",
                Duration = 3,
            })
        end
    end,
})

-- 2. Karakter Hızı (WalkSpeed) Modülü
VisualsSection:Slider({
    Title = "Karakter Hızı (WalkSpeed)",
    Desc = "Karakterin yürüme hızını ayarlar.",
    Min = 16,
    Max = 150,
    Default = 16,
    Step = 1,
    Callback = function(Value)
        Config.WalkSpeedValue = Value
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = Value
                end
            end
        end)
    end,
})

-- 3. Noclip (Duvardan Geçme) Modülü
local NoclipConnection = nil
local NoclipActive = false

VisualsSection:Toggle({
    Title = "Duvardan Geçme (Noclip)",
    Desc = "Duvarlardan ve engellerden geçmenizi sağlar.",
    Default = false,
    Callback = function(State)
        NoclipActive = State
        
        if NoclipActive then
            NoclipConnection = RunService.Stepped:Connect(function()
                pcall(function()
                    if not NoclipActive then return end
                    local char = LocalPlayer.Character
                    if char then
                        for _, part in pairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
            end)
            
            WindUI:Notify({
                Title = "Noclip Modülü",
                Content = "Duvardan geçme etkinleştirildi.",
                Duration = 3,
            })
        else
            if NoclipConnection then
                NoclipConnection:Disconnect()
                NoclipConnection = nil
            end
            
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
            end)
            
            WindUI:Notify({
                Title = "Noclip Modülü",
                Content = "Duvardan geçme kapatıldı.",
                Duration = 3,
            })
        end
    end,
})

-- Karakter Yenilendiğinde Ayarların Korunması
LocalPlayer.CharacterAdded:Connect(function(char)
    char:WaitForChild("Humanoid", 5)
    task.wait(0.5)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Config.WalkSpeedValue
        end
    end)
end)

