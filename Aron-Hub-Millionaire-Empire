-- Özel Miktar Giriş Inputu
MainSection:Input({
    Title = "Eklenecek Miktar (Custom Money)",
    Placeholder = "Miktar gir (Örn: 50000)",
    Default = "999999",
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            Config.CustomMoneyAmount = num
            WindUI:Notify({
                Title = "Para Miktarı Güncellendi",
                Content = "Yeni Miktar: " .. num,
                Duration = 2,
            })
        end
    end,
})

-- Sınırsız Para Döngüsü (Auto-Farm)
local MoneyLoop = nil

MainSection:Toggle({
    Title = "Özel Miktar Para Döngüsü",
    Desc = "ReplicatedStorage.fewjnfejwb3 tetikler.",
    Default = false,
    Callback = function(State)
        if State then
            MoneyLoop = task.spawn(function()
                while true do
                    pcall(function()
                        local moneyEvent = ReplicatedStorage:FindFirstChild("fewjnfejwb3")
                        if moneyEvent and moneyEvent:IsA("RemoteEvent") then
                            moneyEvent:FireServer(Config.CustomMoneyAmount)
                        end
                    end)
                    task.wait(0.8)
                end
            end)
            
            WindUI:Notify({
                Title = "Ekonomi Modülü",
                Content = "Özel miktar para döngüsü başlatıldı.",
                Duration = 3,
            })
        else
            if MoneyLoop then
                task.cancel(MoneyLoop)
                MoneyLoop = nil
            end
            
            WindUI:Notify({
                Title = "Ekonomi Modülü",
                Content = "Özel miktar para döngüsü durduruldu.",
                Duration = 3,
            })
        end
    end,
})

